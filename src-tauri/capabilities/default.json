{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "RepoDeck's own commands, events, and the folder picker. Nothing else.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "dialog:allow-open",
    "allow-app-status",
    "allow-unlock",
    "allow-reset-data",
    "allow-list-roots",
    "allow-add-root",
    "allow-update-root",
    "allow-remove-root",
    "allow-get-excludes",
    "allow-set-excludes",
    "allow-start-scan",
    "allow-cancel-job",
    "allow-list-repos",
    "allow-repo-detail",
    "allow-refresh-repos",
    "allow-get-graph",
    "allow-commit-files",
    "allow-list-accounts",
    "allow-save-account",
    "allow-delete-account",
    "allow-link-account",
    "allow-unlink-account",
    "allow-preview-switch",
    "allow-apply-switch",
    "allow-preview-bulk-switch",
    "allow-apply-bulk-switch",
    "allow-push-check",
    "allow-probe-clone-access",
    "allow-start-clone",
    "allow-start-fetch",
    "allow-start-access-scan",
    "allow-access-matrix",
    "allow-open-in-editor",
    "allow-open-on-github",
    "allow-reveal-repo",
    "allow-generate-ssh-key",
    "allow-test-ssh-key",
    "allow-open-ssh-key-page",
    "allow-trust-github-host",
    "allow-repair-account-key",
    "allow-list-ssh-keys",
    "allow-get-settings",
    "allow-set-settings",
    "allow-clear-graph-cache"
  ]
}
